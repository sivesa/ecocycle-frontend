<?xml version="1.0" encoding="utf-8"?>
<!-- EcoCycle Collector flavor manifest.
     Merged with src/main/AndroidManifest.xml when building the `collector`
     flavor. Collectors need route navigation (background location) plus
     camera/photos for verifying waste payloads. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.CAMERA" />
</manifest>