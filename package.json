{
  "name": "ecocycle-household-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:household",
    "dev:household": "vite --config vite.household.config.ts",
    "dev:collector": "vite --config vite.collector.config.ts",
    "build:household": "tsc -b && vite build --config vite.household.config.ts && node -e \"require('fs').renameSync('dist/household/index.household.html','dist/household/index.html')\"",
    "build:collector": "tsc -b && vite build --config vite.collector.config.ts && node -e \"require('fs').renameSync('dist/collector/index.collector.html','dist/collector/index.html')\"",
    "build": "npm run build:household && npm run build:collector",
    "preview": "npm run preview:household",
    "preview:household": "vite preview --config vite.household.config.ts",
    "preview:collector": "vite preview --config vite.collector.config.ts",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@ionic/react": "^8.2.6",
    "@ionic/react-router": "^8.2.6",
    "@perawallet/connect": "^1.6.1",
    "algosdk": "^3.7.0",
    "ionicons": "^7.4.0",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^5.3.4",
    "react-router-dom": "^5.3.4",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
